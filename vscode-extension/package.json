{
  "name": "flowbuddy-vscode",
  "displayName": "Flow Buddy",
  "description": "Tells the local Flow Buddy daemon whether the editor has focus, vscodevim's mode and how the cursor moved. Numbers and flags only; nothing leaves your machine.",
  "version": "0.1.0",
  "publisher": "flowbuddy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdelrahmanWM/Flow-Buddy"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flowbuddy.settings",
        "title": "Settings\u2026",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.profile",
        "title": "Use a profile\u2026",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.checkSetup",
        "title": "Check setup",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.progress",
        "title": "Progress",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.today",
        "title": "Today",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.recentTips",
        "title": "Recent tips",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.skillMap",
        "title": "Skill map",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.gotIt",
        "title": "Got it (the tip on show)",
        "category": "Flow Buddy"
      },
      {
        "command": "flowbuddy.notHelpful",
        "title": "Not helpful (the tip on show)",
        "category": "Flow Buddy"
      }
    ]
  }
}

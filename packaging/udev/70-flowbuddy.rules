# Flow Buddy: let the user at the local, active session read keyboards
# (and mouse buttons, to notice clicks that change the editor's mode).
#
# `uaccess` grants access through systemd-logind ACLs only to the user
# logged in at the seat, and only while their session is active. That is
# narrower than adding yourself to the `input` group, which lets every
# process of yours read every input device at all times.
#
# Installed by scripts/install.sh --with-udev to /etc/udev/rules.d/.
# It must sort before 73-seat-late.rules, which applies uaccess.

SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_KEYBOARD}=="1", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", TAG+="uaccess"
